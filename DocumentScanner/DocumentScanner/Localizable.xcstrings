    "\"%@\"'s pages will be added to the end of \"%@\", and \"%@\" will be deleted.": {
      "comment": "A message describing the merge of a document into another.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Seiten von „%1$@“ werden am Ende von „%2$@“ hinzugefügt und „%3$@“ wird gelöscht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "\"%1$@\"'s pages will be added to the end of \"%2$@\", and \"%3$@\" will be deleted."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las páginas de \"%1$@\" se añadirán al final de \"%2$@\" y se eliminará \"%3$@\"."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les pages de « %1$@ » seront ajoutées à la fin de « %2$@ », et « %3$@ » sera supprimé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le pagine di \"%1$@\" verranno aggiunte alla fine di \"%2$@\" e \"%3$@\" verrà eliminato."
          }
        }
      }
    },
