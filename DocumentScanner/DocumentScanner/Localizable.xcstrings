    "Touch and hold any document to move it into a folder, merge it into another scan, or rename it. Folders can be renamed the same way.": {
      "comment": "Tip body",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe auf ein Dokument und halte es gedrückt, um es in einen Ordner zu bewegen, mit einem anderen Scan zusammenzuführen oder umzubenennen. Ordner lassen sich genauso umbenennen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén pulsado cualquier documento para moverlo a una carpeta, combinarlo con otro escaneo o cambiarle el nombre. A las carpetas puedes cambiarles el nombre igual."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez un document et maintenez-le pour le déplacer vers un dossier, le fusionner avec un autre scan ou le renommer. Les dossiers se renomment de la même façon."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca e tieni premuto un documento per spostarlo in una cartella, unirlo a un’altra scansione o rinominarlo. Le cartelle si rinominano allo stesso modo."
          }
        }
      }
    },
    "Touch and hold for more": {
      "comment": "Tip title",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippen und halten für mehr Optionen"
          }
        },
        "es": {
