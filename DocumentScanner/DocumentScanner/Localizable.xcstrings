    "Pocket Scanner syncs your documents across devices through iCloud Drive. You can use the app without it — scans will stay on this device only.": {
      "comment": "A description of the benefits of using iCloud Drive with Pocket Scanner.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Pocket Scanner synchronisiert deine Dokumente über iCloud Drive zwischen deinen Geräten. Du kannst die App auch ohne iCloud verwenden — deine Scans bleiben dann nur auf diesem Gerät."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pocket Scanner sincroniza tus documentos entre dispositivos a través de iCloud Drive. Puedes usar la app sin él: los escaneos se quedarán solo en este dispositivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pocket Scanner synchronise vos documents entre vos appareils via iCloud Drive. Vous pouvez utiliser l'app sans cela — les numérisations resteront uniquement sur cet appareil."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Pocket Scanner sincronizza i tuoi documenti tra i dispositivi tramite iCloud Drive. Puoi usare l'app anche senza — le scansioni resteranno solo su questo dispositivo."
          }
        }
      }
    },
    "Pocket Scanner uses your camera to capture documents. Enable access in Settings.": {
      "comment": "A description of why the user needs to enable camera access.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Pocket Scanner verwendet die Kamera, um Dokumente aufzunehmen. Aktiviere den Zugriff in den Einstellungen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pocket Scanner usa la cámara para capturar documentos. Activa el acceso en Ajustes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pocket Scanner utilise l'appareil photo pour capturer des documents. Activez l'accès dans les Réglages."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Pocket Scanner usa la fotocamera per acquisire documenti. Attiva l'accesso in Impostazioni."
          }
        }
      }
    },
    "Prefer everything in one place? Turn off Show Folders in Settings and every scan lives in a single list.": {
      "comment": "Tip body",
      "localizations": {
        "de": {
