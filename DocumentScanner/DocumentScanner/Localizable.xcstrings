    "Search reads the text inside every scan, even ones filed in folders. Tap a result to jump straight to the highlighted match.": {
      "comment": "Tip body",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Suche liest den Text in jedem Scan, auch in denen, die in Ordnern liegen. Tippe auf ein Ergebnis, um direkt zum markierten Treffer zu springen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La búsqueda lee el texto de cada escaneo, incluso los guardados en carpetas. Toca un resultado para ir directamente a la coincidencia resaltada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La recherche lit le texte de chaque numérisation, même celles rangées dans des dossiers. Touchez un résultat pour accéder directement à la correspondance surlignée."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La ricerca legge il testo di ogni scansione, anche di quelle archiviate nelle cartelle. Tocca un risultato per andare direttamente alla corrispondenza evidenziata."
          }
        }
      }
    },
    "Search this folder": {
