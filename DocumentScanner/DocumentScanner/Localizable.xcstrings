          }
        }
      }
    },
    "Try again on a plain, well-lit sheet with a dark pen.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Versuche es erneut auf einem leeren, gut beleuchteten Blatt mit einem dunklen Stift."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vuelve a intentarlo en una hoja lisa y bien iluminada con un bolígrafo oscuro."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Réessayez sur une feuille unie et bien éclairée avec un stylo foncé."
          }
        },
