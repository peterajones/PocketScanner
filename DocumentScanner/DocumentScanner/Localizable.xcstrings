    "Tip: a bold pen on a plain sheet gives the cleanest results.": {
      "comment": "A tip for using a pen to sign.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tipp: Ein kräftiger Stift auf einem leeren Blatt liefert die saubersten Ergebnisse."
          }
        },
        "es": {
